{
  "name": "kindred-coop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm test && cargo test",
    "check": "tsc -p frontend/tsconfig.json --noEmit && cargo check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^24.3.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
